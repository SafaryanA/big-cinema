{
	"name": "big_cinema",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "eslint --max-warnings 0",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"verify": "npm run typecheck && npm run lint && npm run test && npm run build",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test"
	},
	"dependencies": {
		"@hookform/resolvers": "^5.9.1",
		"next": "16.2.7",
		"next-intl": "^4.13.0",
		"react": "19.2.4",
		"react-dom": "19.2.4",
		"react-hook-form": "^7.88.0",
		"swiper": "^12.2.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^24.13.5",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"eslint": "^9",
		"eslint-config-next": "16.2.7",
		"prettier": "^3.9.7",
		"sass": "^1.101.0",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^5.0.1"
	}
}
